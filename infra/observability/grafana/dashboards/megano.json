{
  "uid": "megano-operations",
  "title": "Megano — состояние приложения",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "megano"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Сайт доступен",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "megano-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "up{job=\"megano\"}",
          "refId": "A",
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "title": "База доступна",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "megano-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "megano_queue_database_up",

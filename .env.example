DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Отдельный учебный сервис оплаты (без настоящих банковских платежей).
PAYMENT_SERVICE_URL=http://127.0.0.1:8001/pay
# Одинаковый токен у сайта, очереди и сервиса; если пусто, выводится из DJANGO_SECRET_KEY.
PAYMENT_SERVICE_TOKEN=
# Необязательно: по умолчанию mock-payments.sqlite3 в каталоге проекта.
# PAYMENT_SERVICE_DB=/srv/megano/mock-payments.sqlite3

# Sentry is enabled only when a real project DSN is provided.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=
# Generated by manage.py setup_operations; metrics require Bearer authorization.
METRICS_TOKEN=

# Keep local until copy_media_to_s3 --apply and --verify complete.
MEDIA_STORAGE=local
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION_NAME=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ADDRESSING_STYLE=path
